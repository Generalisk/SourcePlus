<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Project Info-->
	<PropertyGroup>
		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>SourcePlus.$(MSBuildProjectName)</RootNamespace>
		<Company>Source+ Contributors</Company>
		<Version>0.0.0.0</Version>
	</PropertyGroup>

	<!--Output Path-->
	<PropertyGroup>
		<OutputPath>$(MSBuildThisFileDirectory)\..\game\bin\</OutputPath>
		<!--<IntermediateOutputPath>$(MSBuildThisFileDirectory)\obj\$(MSBuildProjectName)\</IntermediateOutputPath>-->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<!--<PublishTrimmed>true</PublishTrimmed>-->
	</PropertyGroup>

	<!--Debug Properties-->
	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<!--Release Properties-->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugType>none</DebugType>
	</PropertyGroup>

	<!--Check if no RuntimeIdentifier has been specified-->
	<!--This is so that by default, .NET will assume your building for your device-->
	<Choose>
		<When Condition="'$(RuntimeIdentifier)'==''">
			<PropertyGroup>
				<DefaultRuntime>true</DefaultRuntime>
			</PropertyGroup>
		</When>
		<Otherwise>
			<PropertyGroup>
				<DefaultRuntime>false</DefaultRuntime>
			</PropertyGroup>
		</Otherwise>
	</Choose>

	<!--Windows Properties-->
	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))Or($(DefaultRuntime)And$([MSBuild]::IsOSPlatform('Windows')))">
		<DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
	</PropertyGroup>

	<!--MacOS/OSX Properties-->
	<!--This platform is not supported by Source+-->
	<!--<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))Or($(DefaultRuntime)And$([MSBuild]::IsOSPlatform('OSX')))">
		<DefineConstants>$(DefineConstants);PLATFORM_OSX</DefineConstants>
	</PropertyGroup>-->

	<!--Linux Properties-->
	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))Or($(DefaultRuntime)And$([MSBuild]::IsOSPlatform('Linux')))">
		<DefineConstants>$(DefineConstants);PLATFORM_LINUX</DefineConstants>
	</PropertyGroup>
	
	<!--Include Common Scripts-->
	<ItemGroup>
		<ProjectReference Include="$(MSBuildThisFileDirectory)\Common\Common.csproj" />
	</ItemGroup>
</Project>
